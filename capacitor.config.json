{
  "appId": "org.virginiavalorfc.staff",
  "appName": "Valor Staff",
  "webDir": "www",
  "backgroundColor": "#0B0B0C",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "cyadylanlab.github.io",
      "www.virginiavalorfc.org",
      "virginiavalorfc.org",
      "script.google.com",
      "script.googleusercontent.com",
      "*.googleusercontent.com",
      "docs.google.com",
      "drive.google.com",
      "accounts.google.com",
      "square.link"
    ]
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0B0C"
    }
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  }
}
